# ===== Unity 标准忽略 =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Uu]IElementsSchema/

# ===== IDE / 工具 =====
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ===== 系统 =====
.DS_Store
Thumbs.db
*.tmp
*.log

# ===== 关键：Unity 打包与库产物 =====
*.apk
*.aab
*.unitypackage
*.app

# ===== 保留 Packages 的 manifest（依赖锁定），但忽略包缓存 =====
/[Pp]ackages/*/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# ===== .workbuddy 本地工作目录，不入版本库 =====
.workbuddy/

# ===== 根目录污染防护：脚本的 .meta 只应存在于 Assets 内 =====
/*.cs.meta
/*.cs
/PMX2FBX_InstallerChecked.txt

# ===== 第三方插件嵌套 .git（追踪插件内容，但不追踪其内部版本控制历史）=====
Assets/Editor/Pmx2Fbx/.git/
Assets/MyToonShader/UnityGenshinToonShader/.git/

# ===== 打包产物（不入版本库：Assets.zip ≈99MB，已贴近 GitHub 单文件 100MB 上限）=====
/Assets.zip
/*.zip

# ===== Python 缓存与配置表回写备份（配置表\tools\ 运行产物）=====
__pycache__/
*.pyc
/配置表/_backup_*/
