# ===== Unity 标准忽略 =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ===== IDE / 工具 =====
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ===== 系统 =====
.DS_Store
Thumbs.db
*.tmp
*.log

# ===== 关键：Unity 打包与库产物 =====
*.apk
*.aab
*.unitypackage
*.app

# ===== 保留 Packages 的 manifest（依赖锁定），但忽略包缓存 =====
/[Pp]ackages/*/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# ===== 保留 .workbuddy 但忽略内部临时 =====
.workbuddy/artifacts/

# ===== 第三方插件嵌套 .git（追踪插件内容，但不追踪其内部版本控制历史）=====
Assets/Editor/Pmx2Fbx/.git/
Assets/MyToonShader/UnityGenshinToonShader/.git/
